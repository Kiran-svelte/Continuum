// ─── Core Models ─────────────────────────────────────────────────────────────

model Company {
  id                    String  @id @default(uuid())
  name                  String
  legalName             String?
  industry              String?
  size                  String?
  country_code          String  @default("IN")
  join_code             String? @unique
  onboarding_completed  Boolean @default(false)
  onboarding_step       Int     @default(0)
  negative_balance      Boolean @default(false)
  timezone              String  @default("Asia/Kolkata")
  work_start            String  @default("09:00")
  work_end              String  @default("18:00")
  work_days             Json    @default("[1,2,3,4,5]")
  grace_period_minutes  Int     @default(15)
  half_day_hours        Float   @default(4)
  leave_year_start      String  @default("01-01")
  probation_period_days Int     @default(180)
  notice_period_days    Int     @default(90)
  sla_hours             Int     @default(48)

  // Dynamic role configuration
  enabled_roles    Json    @default("[\"admin\",\"hr\",\"manager\",\"employee\"]") // Which roles this company uses
  requires_hr      Boolean @default(true) // Does this company need HR role?
  requires_manager Boolean @default(true) // Does this company need Manager role?

  created_at DateTime  @default(now())
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  employees               Employee[]
  leave_types             LeaveType[]
  leave_balances          LeaveBalance[]
  leave_requests          LeaveRequest[]
  leave_encashments       LeaveEncashment[]
  leave_rules             LeaveRule[]
  constraint_policies     ConstraintPolicy[]
  attendances             Attendance[]
  attendance_regs         AttendanceRegularization[]
  approval_hierarchies    ApprovalHierarchy[]
  organization_units      OrganizationUnit[]
  job_levels              JobLevel[]
  salary_structures       SalaryStructure[]
  salary_components       SalaryComponent[]
  salary_revisions        SalaryRevision[]
  payroll_runs            PayrollRun[]
  payroll_slips           PayrollSlip[]
  documents               Document[]
  reimbursements          Reimbursement[]
  employee_movements      EmployeeMovement[]
  status_histories        EmployeeStatusHistory[]
  exit_checklists         ExitChecklist[]
  employee_shifts         EmployeeShift[]
  shifts                  Shift[]
  notifications           Notification[]
  notification_templates  NotificationTemplate[]
  notification_prefs      NotificationPreference[]
  audit_logs              AuditLog[]
  settings_audit_logs     SettingsAuditLog[]
  public_holidays         PublicHoliday[]
  settings                CompanySettings?
  subscriptions           Subscription[]
  payments                Payment[]
  usage_records           UsageRecord[]
  api_keys                ApiKey[]
  otp_tokens              OtpToken[]
  role_permissions        RolePermission[]
  company_roles           CompanyRole[]
  company_role_permissions CompanyRolePermission[]
  employee_invites        EmployeeInvite[]
  user_invites            UserInvite[]
  role_templates          RoleTemplate[]
  channel_identity_links  ChannelIdentityLink[]
  whatsapp_tenant_config  WhatsAppTenantConfig?
  idempotency_records     IdempotencyRecord[]
  assistant_conversations AssistantConversation[]
  workflow_templates      WorkflowTemplate[]
  workflow_instances      WorkflowInstance[]
  domain_events           DomainEvent[]
  payroll_configs         PayrollConfig[]
  goals                   Goal[]
  review_cycles           ReviewCycle[]
  review_templates        ReviewTemplate[]
  review_instances        ReviewInstance[]
  competencies            Competency[]
  job_postings            JobPosting[]
  job_applications        JobApplication[]
  interview_stages        InterviewStage[]
  interviews              Interview[]
  offer_letters           OfferLetter[]
  attendance_policies     AttendancePolicy[]
  courses                 Course[]
  course_enrollments      CourseEnrollment[]
  learning_paths          LearningPath[]
  compensation_cycles     CompensationCycle[]
  compensation_recommendations CompensationRecommendation[]
  travel_requests         TravelRequest[]
  expenses                Expense[]
  payroll_advances        PayrollAdvance[]

  @@index([deleted_at])
}

model Employee {
  id                  String         @id @default(uuid())
  auth_id             String?        @unique // Made optional for invitation flow
  email               String         @unique
  first_name          String
  last_name           String
  phone               String?
  org_id              String? // Made optional for super_admin users
  company             Company?       @relation(fields: [org_id], references: [id], onDelete: Cascade)
  primary_role        Role           @default(employee)
  secondary_roles     Json?
  department          String?
  designation         String?
  date_of_joining     DateTime? // Made optional for invite flow
  gender              Gender? // Made optional for invite flow
  country_code        String         @default("IN")
  status              EmployeeStatus @default(onboarding)
  probation_end_date  DateTime?
  probation_confirmed Boolean        @default(false)
  notice_period_days  Int?
  resignation_date    DateTime?
  last_working_date   DateTime?
  manager_id          String?
  manager             Employee?      @relation("ManagerReports", fields: [manager_id], references: [id], onDelete: SetNull)
  company_role_id     String?
  CompanyRole         CompanyRole?   @relation(fields: [company_role_id], references: [id], onDelete: SetNull)
  created_at          DateTime       @default(now())
  updated_at          DateTime       @updatedAt
  deleted_at          DateTime?

  // ─── New Auth Fields ───────────────────────────────────────────────────────
  password_hash        String? // Hashed password for custom auth
  invited_by_id        String? // Who created this user
  invited_by_type      String? // 'super_admin' | 'admin' | 'hr'
  invite_accepted_at   DateTime? // When user accepted invite
  tutorial_completed   Boolean   @default(false) // Has user completed onboarding tutorial
  last_login_at        DateTime? // Track login activity
  password_changed_at  DateTime? // When password was last changed
  must_change_password Boolean   @default(false) // Force password change on next login

  // Emergency contact
  emergency_contact_name         String?
  emergency_contact_phone        String?
  emergency_contact_relationship String?

  // Bank details
  bank_name           String?
  bank_account_number String?
  ifsc_code           String?

  // Address
  current_address String?

  personal_email           String?
  date_of_birth            DateTime?
  blood_group              String?
  pan_number               String?
  employee_id              String?
  notification_preferences Json?

  direct_reports Employee[] @relation("ManagerReports")

  leave_balances       LeaveBalance[]
  leave_requests       LeaveRequest[]             @relation("EmployeeLeaveRequests")
  approved_requests    LeaveRequest[]             @relation("ApproverLeaveRequests")
  leave_encashments    LeaveEncashment[]          @relation("EmployeeEncashments")
  approved_encashments LeaveEncashment[]          @relation("ApproverEncashments")
  attendances          Attendance[]
  attendance_regs      AttendanceRegularization[] @relation("EmployeeAttendanceRegs")
  approved_att_regs    AttendanceRegularization[] @relation("ApproverAttendanceRegs")

  approval_hierarchy ApprovalHierarchy?  @relation("EmployeeApproval")
  as_level1          ApprovalHierarchy[] @relation("Level1Approver")
  as_level2          ApprovalHierarchy[] @relation("Level2Approver")
  as_level3          ApprovalHierarchy[] @relation("Level3Approver")
  as_level4          ApprovalHierarchy[] @relation("Level4Approver")
  as_hr_partner      ApprovalHierarchy[] @relation("HRPartner")

  headed_units       OrganizationUnit[]       @relation("UnitHead")
  salary_structure   SalaryStructure?
  salary_revisions   SalaryRevision[]         @relation("EmployeeRevisions")
  approved_revisions SalaryRevision[]         @relation("ApproverRevisions")
  payroll_slips      PayrollSlip[]
  documents          Document[]               @relation("EmployeeDocuments")
  verified_documents Document[]               @relation("DocumentVerifier")
  reimbursements     Reimbursement[]          @relation("EmployeeReimbursements")
  approved_reimbs    Reimbursement[]          @relation("ApproverReimbursements")
  movements          EmployeeMovement[]       @relation("EmployeeMovements")
  approved_movements EmployeeMovement[]       @relation("ApproverMovements")
  status_histories   EmployeeStatusHistory[]  @relation("EmployeeStatusHistories")
  changed_statuses   EmployeeStatusHistory[]  @relation("StatusChanger")
  exit_checklists    ExitChecklist[]
  employee_shifts    EmployeeShift[]
  notifications      Notification[]
  notification_prefs NotificationPreference[]
  audit_logs         AuditLog[]
  otp_tokens         OtpToken[]

  generated_payrolls PayrollRun[] @relation("PayrollGenerator")
  approved_payrolls  PayrollRun[] @relation("PayrollApprover")

  sent_invites           UserInvite[]          @relation("InviteSender")
  refresh_tokens         RefreshToken[]
  channel_identity_links ChannelIdentityLink[]
  current_leave_approvals LeaveRequest[] @relation("CurrentLeaveApprover")
  goals                  Goal[] @relation("EmployeeGoals")
  reviewee_reviews       ReviewInstance[] @relation("Reviewee")
  reviewer_reviews       ReviewInstance[] @relation("Reviewer")
  job_postings_created   JobPosting[] @relation("JobPostingCreator")
  referred_applications  JobApplication[] @relation("ApplicationReferrer")
  interviews             Interview[] @relation("Interviewer")
  offer_letters_created  OfferLetter[] @relation("OfferCreator")
  courses_created        Course[] @relation("CourseCreator")
  course_enrollments     CourseEnrollment[] @relation("EmployeeCourseEnrollments")
  learning_paths_created LearningPath[] @relation("LearningPathCreator")
  compensation_cycles_created CompensationCycle[] @relation("CompensationCycleCreator")
  compensation_recommendations CompensationRecommendation[] @relation("EmployeeCompensationRecommendations")
  travel_requests        TravelRequest[] @relation("EmployeeTravelRequests")
  approved_travel_requests TravelRequest[] @relation("TravelApprover")
  current_travel_approvals TravelRequest[] @relation("TravelCurrentApprover")
  expenses               Expense[] @relation("EmployeeExpenses")
  approved_expenses      Expense[] @relation("ExpenseApprover")
  current_expense_approvals Expense[] @relation("ExpenseCurrentApprover")
  payroll_advances       PayrollAdvance[] @relation("EmployeePayrollAdvances")
  approved_payroll_advances PayrollAdvance[] @relation("PayrollAdvanceApprover")
  current_payroll_advance_approvals PayrollAdvance[] @relation("PayrollAdvanceCurrentApprover")
  workflow_instances     WorkflowInstance[] @relation("WorkflowInitiator")
  workflow_actions       WorkflowAction[] @relation("WorkflowActor")

  @@index([org_id])
  @@index([manager_id])
  @@index([company_role_id])
  @@index([status])
  @@index([primary_role])
  @@index([deleted_at])
  @@index([email])
}

// ─── Leave Management ────────────────────────────────────────────────────────

model LeaveType {
  id                  String        @id @default(uuid())
  company_id          String
  company             Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  code                String
  name                String
  category            LeaveCategory
  default_quota       Float         @default(0)
  carry_forward       Boolean       @default(false)
  max_carry_forward   Float         @default(0)
  encashment_enabled  Boolean       @default(false)
  encashment_max_days Float         @default(0)
  paid                Boolean       @default(true)
  gender_specific     GenderFilter?
  is_active           Boolean       @default(true)
  created_at          DateTime      @default(now())
  deleted_at          DateTime?

  @@unique([company_id, code])
  @@index([company_id])
  @@index([is_active])
}

model LeaveBalance {
  id                 String   @id @default(uuid())
  emp_id             String
  employee           Employee @relation(fields: [emp_id], references: [id], onDelete: Cascade)
  leave_type         String
  year               Int
  annual_entitlement Float    @default(0)
  carried_forward    Float    @default(0)
  used_days          Float    @default(0)
  pending_days       Float    @default(0)
  encashed_days      Float    @default(0)
  remaining          Float    @default(0)
  company_id         String
  company            Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  created_at         DateTime @default(now())
  updated_at         DateTime @updatedAt

  @@unique([emp_id, leave_type, year])
  @@index([company_id])
  @@index([emp_id])
}

model LeaveRequest {
  id                String             @id @default(uuid())
  emp_id            String
  employee          Employee           @relation("EmployeeLeaveRequests", fields: [emp_id], references: [id], onDelete: Cascade)
  company_id        String
  company           Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  leave_type        String
  start_date        DateTime
  end_date          DateTime
  total_days        Float
  is_half_day       Boolean            @default(false)
  reason            String?
  status            LeaveRequestStatus @default(draft)
  approved_by       String?
  approver          Employee?          @relation("ApproverLeaveRequests", fields: [approved_by], references: [id], onDelete: SetNull)
  approved_at       DateTime?
  approver_comments String?
  cancel_reason     String?
  attachment_url    String?
  sla_deadline      DateTime?
  sla_breached      Boolean            @default(false)
  escalation_count  Int                @default(0)
  approval_level    Int                @default(0)
  approval_trail    Json?
  current_approver_id String?
  current_approver  Employee?          @relation("CurrentLeaveApprover", fields: [current_approver_id], references: [id], onDelete: SetNull)
  constraint_result Json?
  ai_recommendation Json?
  created_at        DateTime           @default(now())
  updated_at        DateTime           @updatedAt

  @@index([company_id])
  @@index([emp_id])
  @@index([status])
  @@index([created_at])
  @@index([current_approver_id])
}

model LeaveEncashment {
  id          String           @id @default(uuid())
  emp_id      String
  employee    Employee         @relation("EmployeeEncashments", fields: [emp_id], references: [id], onDelete: Cascade)
  company_id  String
  company     Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  leave_type  String
  days        Float
  amount      Float
  status      EncashmentStatus @default(pending)
  approved_by String?
  approver    Employee?        @relation("ApproverEncashments", fields: [approved_by], references: [id], onDelete: SetNull)
  created_at  DateTime         @default(now())

  @@index([company_id])
  @@index([emp_id])
}

// ─── Rules & Policies ────────────────────────────────────────────────────────

model LeaveRule {
  id             String       @id @default(uuid())
  company_id     String
  company        Company      @relation(fields: [company_id], references: [id], onDelete: Cascade)
  rule_id        String
  rule_type      String
  name           String
  description    String?
  category       RuleCategory
  is_blocking    Boolean      @default(true)
  is_active      Boolean      @default(true)
  priority       Int          @default(0)
  config         Json
  effective_from DateTime?
  effective_to   DateTime?
  applies_to_all Boolean      @default(true)
  departments    Json?
  created_at     DateTime     @default(now())
  deleted_at     DateTime?

  @@unique([company_id, rule_id])
  @@index([company_id])
  @@index([is_active])
}

model ConstraintPolicy {
  id         String   @id @default(uuid())
  company_id String
  company    Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  version    Int
  rules      Json
  is_active  Boolean  @default(true)
  created_at DateTime @default(now())

  @@index([company_id])
  @@index([is_active])
}

// ─── Attendance ──────────────────────────────────────────────────────────────

model Attendance {
  id          String           @id @default(uuid())
  emp_id      String
  employee    Employee         @relation(fields: [emp_id], references: [id], onDelete: Cascade)
  company_id  String
  company     Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  date        DateTime
  check_in    DateTime?
  check_out   DateTime?
  status      AttendanceStatus @default(present)
  is_wfh      Boolean          @default(false)
  total_hours Float?
  created_at  DateTime         @default(now())

  regularizations AttendanceRegularization[]

  @@unique([emp_id, date])
  @@index([company_id])
  @@index([emp_id])
  @@index([date])
}

model AttendanceRegularization {
  id            String               @id @default(uuid())
  emp_id        String
  employee      Employee             @relation("EmployeeAttendanceRegs", fields: [emp_id], references: [id], onDelete: Cascade)
  company_id    String
  company       Company              @relation(fields: [company_id], references: [id], onDelete: Cascade)
  attendance_id String?
  attendance    Attendance?          @relation(fields: [attendance_id], references: [id], onDelete: SetNull)
  date          DateTime
  reason        String
  status        RegularizationStatus @default(pending)
  approved_by   String?
  approver      Employee?            @relation("ApproverAttendanceRegs", fields: [approved_by], references: [id], onDelete: SetNull)
  created_at    DateTime             @default(now())

  @@index([company_id])
  @@index([emp_id])
}

// ─── Approval & Organization ─────────────────────────────────────────────────

model ApprovalHierarchy {
  id              String    @id @default(uuid())
  emp_id          String    @unique
  employee        Employee  @relation("EmployeeApproval", fields: [emp_id], references: [id], onDelete: Cascade)
  company_id      String
  company         Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  level1_approver String?
  level1          Employee? @relation("Level1Approver", fields: [level1_approver], references: [id], onDelete: SetNull)
  level2_approver String?
  level2          Employee? @relation("Level2Approver", fields: [level2_approver], references: [id], onDelete: SetNull)
  level3_approver String?
  level3          Employee? @relation("Level3Approver", fields: [level3_approver], references: [id], onDelete: SetNull)
  level4_approver String?
  level4          Employee? @relation("Level4Approver", fields: [level4_approver], references: [id], onDelete: SetNull)
  hr_partner      String?
  hr              Employee? @relation("HRPartner", fields: [hr_partner], references: [id], onDelete: SetNull)
  created_at      DateTime  @default(now())
  updated_at      DateTime  @updatedAt

  @@index([company_id])
}

model OrganizationUnit {
  id          String             @id @default(uuid())
  company_id  String
  company     Company            @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name        String
  type        OrgUnitType
  parent_id   String?
  parent      OrganizationUnit?  @relation("OrgUnitTree", fields: [parent_id], references: [id], onDelete: SetNull)
  children    OrganizationUnit[] @relation("OrgUnitTree")
  head_id     String?
  head        Employee?          @relation("UnitHead", fields: [head_id], references: [id], onDelete: SetNull)
  cost_center String?
  created_at  DateTime           @default(now())
  deleted_at  DateTime?

  @@index([company_id])
  @@index([parent_id])
}

model JobLevel {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name        String
  rank        Int
  description String?
  created_at  DateTime @default(now())

  @@index([company_id])
}

// ─── Payroll & Salary ────────────────────────────────────────────────────────

model SalaryStructure {
  id                String   @id @default(uuid())
  emp_id            String   @unique
  employee          Employee @relation(fields: [emp_id], references: [id], onDelete: Cascade)
  company_id        String
  company           Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  ctc               Float
  basic             Float
  hra               Float
  da                Float    @default(0)
  special_allowance Float    @default(0)
  pf_employee       Float    @default(0)
  pf_employer       Float    @default(0)
  esi_employee      Float    @default(0)
  esi_employer      Float    @default(0)
  professional_tax  Float    @default(0)
  tds               Float    @default(0)
  effective_from    DateTime
  created_at        DateTime @default(now())

  @@index([company_id])
}

model SalaryComponent {
  id         String              @id @default(uuid())
  company_id String
  company    Company             @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name       String
  type       SalaryComponentType
  is_taxable Boolean             @default(true)
