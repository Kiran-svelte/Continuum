/// Maps an employee to a messaging channel (e.g., WhatsApp) identity.
/// Revocable on phone change, employee termination, or admin block.
model ChannelIdentityLink {
  id            String    @id @default(uuid())
  company_id    String
  company       Company   @relation(fields: [company_id], references: [id], onDelete: Cascade)
  employee_id   String
  employee      Employee  @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  channel       String    @db.VarChar(32) // 'whatsapp'
  external_id   String    @db.VarChar(32) // Meta wa_id (digits, no +)
  phone_e164    String    @db.VarChar(20)
  verified_at   DateTime
  revoked_at    DateTime?
  revoke_reason String?   @db.VarChar(64)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt

  @@unique([company_id, channel, external_id])
  @@index([company_id, phone_e164])
  @@index([employee_id, channel])
}

/// Stores OTP challenge for channel phone verification.
model ChannelVerificationChallenge {
  id           String    @id @default(uuid())
  company_id   String
  employee_id  String
  channel      String    @db.VarChar(32)
  phone_e164   String    @db.VarChar(20)
  code_hash    String // bcrypt cost 10
  attempts     Int       @default(0)
  max_attempts Int       @default(3)
  expires_at   DateTime
  consumed_at  DateTime?
  created_at   DateTime  @default(now())

  @@index([company_id, employee_id, channel])
  @@index([expires_at])
}

/// Per-tenant WhatsApp Business Account configuration.
/// access_token_enc is AES-256-GCM encrypted (never returned in GET responses).
model WhatsAppTenantConfig {
  id                String   @id @default(uuid())
  company_id        String   @unique
  company           Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  phone_number_id   String   @unique @db.VarChar(32)
  waba_id           String?  @db.VarChar(64)
  access_token_enc  String // AES-256-GCM: base64(iv+ciphertext+tag)
  messaging_enabled Boolean  @default(true)
  connected_at      DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt

  @@index([company_id])
}

/// Idempotency record for headless service calls.
/// Caches ServiceResult for 24h to prevent duplicate operations.
model IdempotencyRecord {
  id              String   @id @default(uuid())
  company_id      String
  employee_id     String
  idempotency_key String   @db.VarChar(128)
  response_json   Json
  http_status     Int
  expires_at      DateTime
  created_at      DateTime @default(now())

  company Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  @@unique([company_id, employee_id, idempotency_key])
  @@index([company_id])
  @@index([expires_at])
}

/// Persistent conversation context for the Continuum assistant.
model AssistantConversation {
  id               String    @id @default(uuid())
  company_id       String
  employee_id      String
  channel          String    @db.VarChar(32) // 'web' | 'whatsapp'
  draft_json       Json?
  draft_expires_at DateTime?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @updatedAt

  company  Company                  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  messages AssistantMessageRecord[]

  @@unique([company_id, employee_id, channel])
  @@index([company_id, employee_id])
}

/// Individual message records for conversation history (pruned to 40).
model AssistantMessageRecord {
  id              String                @id @default(uuid())
  conversation_id String
  conversation    AssistantConversation @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  company_id      String
  role            String                @db.VarChar(16) // 'user' | 'assistant'
  content         String
  created_at      DateTime              @default(now())

  @@index([conversation_id])
  @@index([company_id])
  @@index([created_at])
}

/// Channel blocklist — silently ignores messages from blocked senders.
model ChannelBlocklist {
  id          String   @id @default(uuid())
  company_id  String
  channel     String   @db.VarChar(32) // 'whatsapp'
  external_id String   @db.VarChar(64)
  reason      String?
  created_by  String?
  created_at  DateTime @default(now())

  @@unique([company_id, channel, external_id])
  @@index([company_id])
}
