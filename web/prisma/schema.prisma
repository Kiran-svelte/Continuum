  new_regime
}

enum GoalCategory {
  company
  department
  team
  individual
}

enum MetricType {
  percentage
  number
  currency
  boolean
}

enum GoalStatus {
  not_started
  in_progress
  completed
  cancelled
  deferred
}

enum ReviewCycleType {
