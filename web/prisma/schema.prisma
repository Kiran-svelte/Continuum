  currency            String               @default("INR")
  reason              String?
  repayment_months    Int                  @default(1)
  status              PayrollAdvanceStatus @default(pending)
  approved_by         String?
  Approver            Employee?            @relation("PayrollAdvanceApprover", fields: [approved_by], references: [id], onDelete: SetNull)
  approved_at         DateTime?
  current_approver_id String?
  CurrentApprover     Employee?            @relation("PayrollAdvanceCurrentApprover", fields: [current_approver_id], references: [id], onDelete: SetNull)
  rejection_note      String?
