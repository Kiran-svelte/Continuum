// ─── NEW AUTH SYSTEM MODELS ──────────────────────────────────────────────────

model CompanyRole {
  id                String        @id @default(uuid())
  company_id        String
  company           Company       @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name              String
  slug              String
  base_role         Role?
  description       String?
  color             String?
  icon              String?
  authority_level   Int           @default(50)
  reports_to_id     String?
  CompanyRole       CompanyRole?  @relation("CompanyRoleHierarchy", fields: [reports_to_id], references: [id], onDelete: SetNull)
  other_CompanyRole CompanyRole[] @relation("CompanyRoleHierarchy")
  is_owner_role     Boolean       @default(false)
  can_create_users  Boolean       @default(false)
  can_create_roles  Json          @default("[]")
  is_active         Boolean       @default(true)
  created_at        DateTime      @default(now())
  updated_at        DateTime      @updatedAt

  Employee              Employee[]
  CompanyRolePermission CompanyRolePermission[]

  @@unique([company_id, slug])
  @@index([company_id])
  @@index([reports_to_id])
  @@index([base_role])
}

model CompanyRolePermission {
  id              String      @id @default(uuid())
  company_id      String
  company         Company     @relation(fields: [company_id], references: [id], onDelete: Cascade)
  company_role_id String
  CompanyRole     CompanyRole @relation(fields: [company_role_id], references: [id], onDelete: Cascade)
  permission_id   String
  Permission      Permission  @relation(fields: [permission_id], references: [id], onDelete: Cascade)
  granted         Boolean     @default(true)
  scope           String      @default("all")
  created_at      DateTime    @default(now())

  @@unique([company_role_id, permission_id])
  @@index([company_id])
  @@index([company_role_id])
  @@index([permission_id])
}

// Super Admin - Platform level (You, the platform owner)
model SuperAdmin {
  id            String    @id @default(uuid())
  email         String    @unique
  password_hash String
  name          String
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @updatedAt
  last_login_at DateTime?

  created_invites UserInvite[] @relation("SuperAdminInvites")
  refresh_tokens  RefreshToken[]
}

// User Invitation - Sent by super_admin, admin, or hr to create new users
model UserInvite {
  id         String       @id @default(uuid())
  email      String
  first_name String
  last_name  String
  role       Role
  status     InviteStatus @default(pending)

  // Company association (null for company owner invites)
  company_id String?
  company    Company? @relation(fields: [company_id], references: [id], onDelete: Cascade)

  // Who sent the invite
  invited_by_id       String?
  invited_by_employee Employee?   @relation("InviteSender", fields: [invited_by_id], references: [id], onDelete: SetNull)
  invited_by_super_id String?
  invited_by_super    SuperAdmin? @relation("SuperAdminInvites", fields: [invited_by_super_id], references: [id], onDelete: SetNull)

  // Invitation token
  token       String    @unique
  expires_at  DateTime
  accepted_at DateTime?

  // Optional metadata
  department  String?
  designation String?
  message     String? // Personal message in invite email

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([email])
  @@index([token])
  @@index([status])
  @@index([company_id])
}

// Role Template - Company-specific role configuration
model RoleTemplate {
  id         String  @id @default(uuid())
  company_id String
  company    Company @relation(fields: [company_id], references: [id], onDelete: Cascade)

  role_name   String // Display name (e.g., "HR Manager", "Team Lead")
  base_role   Role // Maps to system role
  description String?

  // Permission customization
  permissions          Json // Array of permission codes
  excluded_permissions Json? // Permissions removed from base role

  // Approval chain configuration
  approval_level     Int? // Position in approval chain (1 = first, null = not in chain)
  can_approve_leaves Boolean @default(false)
  can_create_users   Boolean @default(false)

  is_active  Boolean  @default(true)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([company_id, role_name])
  @@index([company_id])
  @@index([base_role])
}

// Refresh Token - For JWT token rotation
model RefreshToken {
  id          String   @id @default(uuid())
  token_hash  String   @unique
  employee_id String?
  employee    Employee? @relation(fields: [employee_id], references: [id], onDelete: Cascade)
  super_admin_id String?
  super_admin    SuperAdmin? @relation(fields: [super_admin_id], references: [id], onDelete: Cascade)

  device_info String? // Browser/device identifier
  ip_address  String?

  expires_at DateTime
  revoked_at DateTime?
  created_at DateTime  @default(now())

  @@index([employee_id])
  @@index([super_admin_id])
  @@index([expires_at])
}

// Session - Active user sessions
model Session {
  id            String @id @default(uuid())
  session_token String @unique
  employee_id   String

  device_info String?
  ip_address  String?
  user_agent  String?

  expires_at    DateTime
  created_at    DateTime @default(now())
  last_activity DateTime @default(now())

  @@index([employee_id])
  @@index([expires_at])
}

// Tutorial Progress - Track onboarding tutorial completion

model PasswordResetToken {
  id         String   @id @default(uuid())
  email      String
  token_hash String   @unique
  expires_at DateTime
  is_used    Boolean  @default(false)
  created_at DateTime @default(now())

  @@index([email])
}

model TutorialProgress {
  id          String @id @default(uuid())
  employee_id String

  step_id      String // Tutorial step identifier
  completed    Boolean   @default(false)
  completed_at DateTime?
  skipped      Boolean   @default(false)

  created_at DateTime @default(now())

  @@unique([employee_id, step_id])
  @@index([employee_id])
}

// ─── Zero UI Channel Identity (L5-03-001) ────────────────────────────────────

model WorkflowTemplate {
  id          String   @id @default(uuid())
  company_id  String
  company     Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  name        String
  description String?
  entity_type String
  is_active   Boolean  @default(true)
  version     Int      @default(1)
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  steps     WorkflowStep[]
  instances WorkflowInstance[]

  @@index([company_id])
  @@index([entity_type])
  @@index([is_active])
}

model WorkflowStep {
  id            String               @id @default(uuid())
  template_id   String
  template      WorkflowTemplate     @relation(fields: [template_id], references: [id], onDelete: Cascade)
  step_order    Int
  name          String
  approver_type WorkflowApproverType
  approver_role Role?
  approver_id   String?
  is_optional   Boolean              @default(false)
  timeout_hours Int?
  created_at    DateTime             @default(now())

  @@unique([template_id, step_order])
  @@index([template_id])
}

model WorkflowInstance {
  id           String           @id @default(uuid())
  template_id  String
  template     WorkflowTemplate @relation(fields: [template_id], references: [id], onDelete: Cascade)
  company_id   String
  company      Company          @relation(fields: [company_id], references: [id], onDelete: Cascade)
  entity_type  String
  entity_id    String
  initiated_by String
  Employee     Employee         @relation("WorkflowInitiator", fields: [initiated_by], references: [id], onDelete: Cascade)
  current_step Int              @default(1)
