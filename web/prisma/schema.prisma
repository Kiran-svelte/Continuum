generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Role {
  super_admin // Platform level - creates company owners
  admin // Company owner - full access
  hr // HR operations
  director // Division level
  manager // Department level
  team_lead // Team level
  employee // Self-service only
}

enum InviteStatus {
  pending
  accepted
  expired
  revoked
}

enum Gender {
  male
  female
  other
}

enum GenderFilter {
  male
  female
  all
}

enum EmployeeStatus {
  onboarding
  probation
  active
  on_notice
  suspended
  resigned
  terminated
  exited
}

enum LeaveCategory {
  common
  statutory
  special
  unpaid
}

enum LeaveRequestStatus {
  draft
  pending
  approved
  rejected
  cancelled
  escalated
}

enum EncashmentStatus {
  pending
  approved
  processed
  rejected
}

enum RuleCategory {
