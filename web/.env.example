UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# �??�?? Email (SMTP) �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Option A: Gmail App Password (development)
#   1. Enable 2FA on Google account
#   2. Go to myaccount.google.com �?? Security �?? App Passwords
#   3. Generate a password for "Mail"
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Continuum HR

# Option B: Resend (production)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxx
# RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# �??�?? Razorpay (Billing) �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Get from: https://dashboard.razorpay.com �?? Settings �?? API Keys
# Use test keys (rzp_test_*) for development.
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# �??�?? OpenAI (AI Engine) �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Get from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key

# -- WhatsApp Cloud API / Zero UI --------------------------------------------
# App-level Meta webhook verification token for GET hub.challenge.
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
# App secret used to verify X-Hub-Signature-256 on inbound webhooks.
WHATSAPP_WEBHOOK_SECRET=replace-with-meta-app-secret
# 32-byte AES key encoded as base64. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# �??�?? Pusher (Real-time Notifications) �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Get from: https://dashboard.pusher.com �?? your app �?? App Keys
PUSHER_APP_ID=replace-with-pusher-app-id
PUSHER_KEY=replace-with-pusher-key
PUSHER_SECRET=replace-with-pusher-secret
PUSHER_CLUSTER=ap2

# �??�?? Application �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# �??�?? Misc �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Prevents ws from loading optional bufferutil stubbed by Next.js bundler.
WS_NO_BUFFER_UTIL=1

# -- 21st.dev (optional UI scaffolding; server-only in lib/integrations/twentyfirst/env.ts) --
TWENTYFIRST_DEV_API_KEY=
TWENTYFIRST_DEV_BASE_URL=https://api.21st.dev

# -- White-Label / Tenant Branding ----------------------------------------------
# Set these to rebrand this platform for resellers or enterprise deployments.
# WARNING: Changing COOKIE_PREFIX or JWT_ISSUER after go-live invalidates ALL sessions.
#
# Product name in UI, emails, and page titles
NEXT_PUBLIC_PRODUCT_NAME=Continuum
# Short tagline (footer and email header)
NEXT_PUBLIC_PRODUCT_TAGLINE=HR operations, finally done right.
# Prefix for all session cookies (avoid collisions on shared domains)
COOKIE_PREFIX=continuum
# JWT iss claim ? must match when tokens were minted; change = all JWTs invalid
JWT_ISSUER=continuum
# Comma-separated accepted JWT audiences
JWT_AUDIENCES=continuum-web,continuum-api
# Display name in From: header of all outbound emails
EMAIL_FROM_NAME=Continuum HR
# Reply-to / support address shown in email footers
SUPPORT_EMAIL=support@continuumhr.app

# Set to true for dev/demo credential-first signup on /sign-up (production stays invitation-only)
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
