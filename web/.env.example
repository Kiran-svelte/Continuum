# Continuum HRMS environment variables
# Copy this file to .env and fill in all values.
# Never commit real secrets.

# Auth
JWT_SECRET=replace-with-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-hex-string
SESSION_SECRET=replace-with-session-secret
CSRF_SECRET=replace-with-csrf-secret

# Supabase project
NEXT_PUBLIC_SUPABASE_URL=https://tpffianqmjbaobelzlyw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# Supabase Postgres
# Use the pooler URL for runtime/serverless Prisma queries.
DATABASE_URL=postgresql://postgres.tpffianqmjbaobelzlyw:replace-with-db-password@aws-0-region.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&pool_timeout=30&connect_timeout=30&sslmode=require
# Use the direct URL for Prisma migrations and one-off admin scripts.
DIRECT_URL=postgresql://postgres:replace-with-db-password@db.tpffianqmjbaobelzlyw.supabase.co:5432/postgres?sslmode=require&connect_timeout=30
SUPABASE_DATABASE_URL=${DATABASE_URL}
SUPABASE_DIRECT_URL=${DIRECT_URL}

# Appwrite document infrastructure
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a0c1929002c719bd1be
APPWRITE_DATABASE_ID=6a0c19610039b961689f
APPWRITE_STORAGE_BUCKET_ID=6a0c19a90004bdd511a1
APPWRITE_API_KEY=replace-with-appwrite-server-api-key
MODULE_STATE_SOURCE=prisma

# Redis
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token
REDIS_URL=

# Email
EMAIL_PROVIDER=smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com
EMAIL_FROM_NAME=Continuum HR
SENDGRID_API_KEY=
RESEND_API_KEY=

# Payments
RAZORPAY_KEY_ID=rzp_test_replace_with_your_key_id
RAZORPAY_KEY_SECRET=replace-with-your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-your-razorpay-webhook-secret

# AI
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key

# Realtime
PUSHER_APP_ID=replace-with-pusher-app-id
PUSHER_KEY=replace-with-pusher-key
NEXT_PUBLIC_PUSHER_KEY=replace-with-pusher-key
PUSHER_SECRET=replace-with-pusher-secret
PUSHER_CLUSTER=ap2

# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
CONSTRAINT_ENGINE_URL=http://localhost:8001
CRON_SECRET=replace-with-cron-secret
NODE_ENV=development
WS_NO_BUFFER_UTIL=1

# Optional UI scaffolding
TWENTYFIRST_DEV_API_KEY=
TWENTYFIRST_DEV_BASE_URL=https://api.21st.dev

# White-label / tenant branding
NEXT_PUBLIC_PRODUCT_NAME=Continuum
NEXT_PUBLIC_PRODUCT_TAGLINE=HR operations, finally done right.
COOKIE_PREFIX=continuum
JWT_ISSUER=continuum
JWT_AUDIENCES=continuum-web,continuum-api
SUPPORT_EMAIL=support@continuumhr.app

# Public signup is disabled in production; invitation-first remains default.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false
