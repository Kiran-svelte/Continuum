# CONTINUUM HRMS �?? Environment Variables
# Copy this file to .env and fill in all values.
# NEVER commit a .env file with real secrets to version control.
# �?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?��?�

# �??�?? JWT Auth �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# -- Appwrite (auth bridge, database, storage) -------------------------------
# Server API key: never expose to the client or NEXT_PUBLIC_* vars.
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=6a0c1929002c719bd1be
APPWRITE_DATABASE_ID=6a0c19610039b961689f
APPWRITE_STORAGE_BUCKET_ID=6a0c19a90004bdd511a1
APPWRITE_API_KEY=replace-with-appwrite-server-api-key
# prisma (default) | appwrite — module cap source; appwrite requires company_modules collection
MODULE_STATE_SOURCE=prisma

JWT_SECRET=replace-with-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-hex-string

# �??�?? Database (Neon Postgres) �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
# Get from: https://console.neon.tech �?? your project �?? Connection string
# Pooled connection for application queries
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Direct (non-pooled) for migrations
DIRECT_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require&channel_binding=require
# Legacy aliases (same values)
NEON_DATABASE_URL=${DATABASE_URL}
NEON_DIRECT_URL=${DIRECT_URL}

# �??�?? Neon Auth (optional �?? only if using Neon Auth stack) �??�??
NEON_AUTH_URL=https://ep-xxx.region.aws.neon.tech/neondb/auth
NEON_JWKS_URL=https://ep-xxx.region.aws.neon.tech/neondb/auth/.well-known/jwks.json
NEON_API_KEY=napi_replace_with_your_neon_api_key

# �??�?? Redis (Upstash) �??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??�??
