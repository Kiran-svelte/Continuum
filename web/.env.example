# Continuum HR - Environment Variables
# Copy this file to .env and fill in local values.
# Never commit a .env file containing real secrets.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000
WS_NO_BUFFER_UTIL=1

# Public signup must stay false in production because the product is invite-only.
NEXT_PUBLIC_ALLOW_PUBLIC_SIGNUP=false

# ---------------------------------------------------------------------------
# White-label / Tenant Branding
# ---------------------------------------------------------------------------
NEXT_PUBLIC_PRODUCT_NAME=Continuum
NEXT_PUBLIC_PRODUCT_TAGLINE=HR operations, finally done right.
EMAIL_FROM_NAME=Continuum HR
SUPPORT_EMAIL=support@continuumhr.app

# Changing COOKIE_PREFIX, JWT_ISSUER, or JWT_AUDIENCES after go-live can
# invalidate existing sessions.
COOKIE_PREFIX=continuum
JWT_ISSUER=continuum
JWT_AUDIENCES=continuum-web,continuum-api

# ---------------------------------------------------------------------------
# JWT Auth
# ---------------------------------------------------------------------------
# Generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace-with-64-byte-random-hex-string
JWT_REFRESH_SECRET=replace-with-different-64-byte-random-hex-string

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
DIRECT_URL=postgresql://user:password@host:5432/database?sslmode=require
NEON_DATABASE_URL=${DATABASE_URL}
NEON_DIRECT_URL=${DIRECT_URL}

# Optional Neon Auth compatibility values.
NEON_AUTH_URL=
NEON_JWKS_URL=
NEON_API_KEY=

# ---------------------------------------------------------------------------
# Appwrite Bridge
# ---------------------------------------------------------------------------
APPWRITE_ENDPOINT=https://fra.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=replace-with-appwrite-project-id
APPWRITE_DATABASE_ID=replace-with-appwrite-database-id
APPWRITE_STORAGE_BUCKET_ID=replace-with-appwrite-storage-bucket-id
APPWRITE_API_KEY=replace-with-appwrite-server-api-key

# prisma | appwrite
MODULE_STATE_SOURCE=prisma

# ---------------------------------------------------------------------------
# Redis / Rate Limiting
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://replace-with-upstash-url
UPSTASH_REDIS_REST_TOKEN=replace-with-upstash-rest-token

# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Production default.
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@your-verified-domain.com

# Optional SMTP fallback / development.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM=your-email@gmail.com

# Optional SendGrid legacy provider.
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ---------------------------------------------------------------------------
# Payments
# ---------------------------------------------------------------------------
# Cashfree is the primary payment processor.
CASHFREE_APP_ID=replace-with-cashfree-app-id
CASHFREE_SECRET_KEY=replace-with-cashfree-secret-key
CASHFREE_WEBHOOK_SECRET=replace-with-cashfree-webhook-secret
CASHFREE_ENV=sandbox
NEXT_PUBLIC_CASHFREE_ENV=sandbox

# Razorpay is legacy. Keep empty unless old routes are intentionally used.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Cloudflare R2 / S3-compatible Upload Storage
# ---------------------------------------------------------------------------
UPLOAD_BUCKET=continuum-files
UPLOAD_REGION=auto
UPLOAD_ACCESS_KEY=replace-with-r2-access-key
UPLOAD_SECRET_KEY=replace-with-r2-secret-key
UPLOAD_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
UPLOAD_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Realtime Notifications
# ---------------------------------------------------------------------------
PUSHER_APP_ID=replace-with-pusher-app-id
PUSHER_KEY=replace-with-pusher-key
PUSHER_SECRET=replace-with-pusher-secret
PUSHER_CLUSTER=ap2

# ---------------------------------------------------------------------------
# OpenAI / Assistant
# ---------------------------------------------------------------------------
OPENAI_API_KEY=sk-proj-replace-with-your-openai-api-key

# ---------------------------------------------------------------------------
# WhatsApp Cloud API / Zero UI
# ---------------------------------------------------------------------------
WHATSAPP_VERIFY_TOKEN=replace-with-meta-webhook-verify-token
WHATSAPP_WEBHOOK_SECRET=replace-with-meta-app-secret
# 32-byte AES key encoded as base64:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
WHATSAPP_TOKEN_ENCRYPTION_KEY=replace-with-32-byte-base64-key

# ---------------------------------------------------------------------------
# Optional Integrations
# ---------------------------------------------------------------------------
TWENTYFIRST_DEV_API_KEY=
TWENTYFIRST_DEV_BASE_URL=https://api.21st.dev
